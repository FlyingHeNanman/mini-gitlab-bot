# ===== 网关 =====
WEBHOOK_SECRET=change-me-to-a-long-random-string
AGENT_CONCURRENCY=2
WORK_DIR=/work
DB_PATH=/data/tasks.db

# ===== GitLab =====
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-your-bot-token
REPO_WHITELIST=group/project-a,group/project-b
TARGET_BRANCH=main
AI_FIX_LABEL=ai-fix

# ===== Codex / LLM =====
