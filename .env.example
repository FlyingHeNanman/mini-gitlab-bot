# ===== 网关 =====
WEBHOOK_SECRET=change-me-to-a-long-random-string
AGENT_CONCURRENCY=2
WORK_DIR=/work
DB_PATH=/data/tasks.db
WORKER_ENABLED=true
WORKER_OWNER=worker-1
PORT=8080

# ===== 触发闸门（PLAN §7 加固基线 8）=====
REPO_WHITELIST=group/project-a,group/project-b
AI_FIX_LABEL=ai-fix
BOT_USERNAME=mini-gitlab-bot
# 可选：额外白名单（与角色下限是 AND 关系；也是实例管理员不在成员表里时的逃生门）
ALLOWED_TRIGGER_USERS=
# Developer=30；低于 30 会让只读成员借机器人提权，启动时会告警
MIN_ACCESS_LEVEL=30
MEMBER_CACHE_TTL_SEC=60

# ===== GitLab =====
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-your-bot-token
# 只读迷你 MCP 专用 token（scope: read_api）。**只能是只读**：它会被传给 codex 启动的
# MCP 子进程（经 env_vars 按名透传，值不进 argv/配置/日志）。留空 = 关闭 MCP。
GITLAB_READONLY_TOKEN=
# 单次 API 调用超时（秒）；5xx / 连接错误由 python-gitlab 自动重试
GITLAB_TIMEOUT_SEC=30
# 进 context.md 的 issue 评论条数（只取最新 N 条人类评论，system note 一律丢弃）
ISSUE_COMMENT_LIMIT=20

# ===== 任务与租约 =====
AGENT_TIMEOUT_SEC=1800
LEASE_SECONDS=60
POLL_INTERVAL_SEC=1
MAX_ATTEMPTS=3

# ===== 日志与保留策略（M2 / M5）=====
# codex.jsonl / last-message.md / uv-sync.log 落在 <LOG_DIR>/<task_id>/。
# 刻意放在 job 目录之外：job 目录终态即清，而这些日志要留 14 天（PLAN §9 M5）
LOG_DIR=/data/logs
# 结构化日志：容器里用 json（一行一条，带 task_id），本地开发可改 text
LOG_LEVEL=INFO
LOG_FORMAT=json
# 保留策略：codex/uv 日志留 14 天、终态任务留 90 天、孤儿 job 目录留 1 天
LOG_RETENTION_DAYS=14
TASK_RETENTION_DAYS=90
ORPHAN_JOB_RETENTION_DAYS=1
JANITOR_INTERVAL_SEC=3600
# 只读任务页 /tasks（HTML + /tasks.json）。留空 = 完全关闭（404，v1 默认）。
# 设置后首次访问用 `?token=...`，随后换成 HttpOnly Cookie；脚本可用 X-Admin-Token 头。
# 至少 16 位随机串，例如：openssl rand -hex 24
ADMIN_TOKEN=
# Prometheus 文本指标（GET /metrics）；不建议在公网暴露
METRICS_ENABLED=true
# /readyz 判定"任务卡死"的阈值（租约过期多少秒算异常）
READY_STALE_SEC=180

# ===== git（M2）=====
GIT_BIN=git
# 提交身份（agent 在沙箱里自己 commit 时也用这套，clone 后已就近配好）
GIT_AUTHOR_NAME=mini-gitlab-bot
GIT_AUTHOR_EMAIL=mini-gitlab-bot@localhost
# 0 = 完整 clone；>0 用 --depth（依赖服务端能力，出问题就退回 0）
GIT_CLONE_DEPTH=0
GIT_TIMEOUT_SEC=600

# ===== uv 准备阶段（M2，网关侧联网）=====
UV_BIN=uv
# 空 = <WORK_DIR>/.uv-cache。必须是容器卷内可写路径（沙箱里 ~/.cache 不可写）
UV_CACHE_DIR=
# 内网 kkRepo 源
UV_DEFAULT_INDEX=https://kkrepo.internal/simple
UV_SYNC_TIMEOUT_SEC=1800

# ===== Codex（M2）=====
CODEX_BIN=codex
# provider 名（`-c model_providers.<名>.*`）；一般不用改
MODEL_PROVIDER=internal
# 内网模型端点（必须支持 OpenAI Responses API，即 /v1/responses）
MODEL_BASE_URL=http://llm-gateway:8000/v1
MODEL_NAME=
# 只传"变量名"给 codex（-c ...env_key），值只进子进程环境，绝不进 argv / 日志
API_KEY_ENV=LLM_API_KEY
LLM_API_KEY=
# 版本自检（PLAN §7 基线 6 要求 pin；为空时启动告警）
CODEX_EXPECTED_VERSION=
# 追加的 -c key=value，逗号分隔
# 例：CODEX_CONFIG=model_providers.internal.base_url=https://llm.internal/v1,model_providers.internal.wire_api="responses"
CODEX_CONFIG=

# ===== 只读迷你 MCP（M4）=====
# 总开关；没有 GITLAB_READONLY_TOKEN 时自动失效（不会退而求其次用写 token）
MCP_ENABLED=true
# 启动 MCP server 的解释器（空 = 与网关同一个）
MCP_PYTHON=
# 单次工具输出上限（字符）；超出会截断并告诉模型"被截断了"
MCP_MAX_OUTPUT_CHARS=20000

# ===== diff 策略（逗号分隔）=====
DIFF_MAX_FILES=50
DIFF_MAX_LINES=2000
FORBIDDEN_PATHS=.gitlab-ci.yml,.gitlab/,.mini-gitlab-bot.yaml,.env,*.pem,*.key,id_rsa*

# 注：TARGET_BRANCH 已删除（改为按项目 default_branch）；RENOVATE_TOKEN 已删除（Renovate 不进本项目）
